# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=EURO_ver_y_data.settings
DEBUG=True
SECRET_KEY=django-insecure-cambia-esta-clave-en-produccion

# ── Base de datos PostgreSQL ──────────────────────────────────────────────────
DB_NAME=ver_y_data
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_HOST=localhost
DB_PORT=5432

# ── JWT ───────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_LIFETIME=60          # minutos
REFRESH_TOKEN_LIFETIME=1          # días

# ── Email (Microsoft Graph API / Office 365) ──────────────────────────────────
# App Registration en Azure AD con permiso Mail.Send (application)
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Celery + Redis ────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
DB_PASSWORD=tu_password_aqui
# ── CORS ──────────────────────────────────────────────────────────────────────
# En producción reemplaza con el dominio real (sin barra final)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ─── OptimizacionCorreos — RADIAN ────────────────────────────────────────────
OC_DIAN_NIT=900XXXXXX
OC_DIAN_CC_REP_ENC=<generado por manage.py configurar_secretos>
OC_DIAN_NOMBRE_REP=NombreRepresentante
OC_CAPSOLVER_API_KEY=CAP-XXXXX
OC_CAPSOLVER_SITE_KEY=0x4AAAAAAAg1WuNb-OnOa76z
OC_GRAPH_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
OC_GRAPH_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
OC_GRAPH_MAILBOX_UPN=buzon@dominio.com
OC_GRAPH_CERT_KEY_PATH=./certs/oc_graph.key.pem
OC_GRAPH_CERT_PUB_PATH=./certs/oc_graph.cer

# ─── OptimizacionCorreos — Zimbra ─────────────────────────────────────────────
OC_ZIMBRA_HOST=mail.eurosupermercados.com
OC_ZIMBRA_EMAIL=facturaelectronica@eurosupermercados.com
OC_ZIMBRA_PASSWORD_ENC=<generado por manage.py configurar_secretos>
OC_ZIMBRA_API_URL=http://localhost:8765

# ─── OptimizacionCorreos — Config ─────────────────────────────────────────────
OC_MASTER_KEY_PATH=./secrets/oc_master.key

# ─── Migración Masiva de Archivo — SAIA ──────────────────────────────────────
SAIA_USER=usuario_saia
SAIA_PASSWORD=tu_password_aqui
SAIA_BASE_URL=https://eurosupermercados.netsaia.com/eurosupermercados/saia/index.php
SAIA_TIMEOUT_MS=30000
SAIA_MAX_REINTENTOS_RED=5
SAIA_CONSECUTIVO_DELTA_MAX=50
SAIA_MAX_FILE_MB=50
# Capturas de pantalla de cada intento de carga (auditoria) — debe ser disco persistente
SAIA_SCREENSHOT_DIR=/var/lib/migracion-masiva-archivo/saia_screenshots
# Retencion de capturas (Celery Beat, 3:10 AM diario) — ver tasks.purgar_screenshots_saia
SAIA_SCREENSHOT_RETENTION_DIAS=30

# ─── Migración Masiva de Archivo — OCR (Tesseract) ───────────────────────────
# Binario e idiomas instalados a nivel de sistema operativo (apt install tesseract-ocr
# tesseract-ocr-spa tesseract-ocr-eng en Debian/Ubuntu), NO se instalan con pip.
TESSERACT_CMD=/usr/bin/tesseract
TESSDATA_DIR=/usr/share/tesseract-ocr/5/tessdata

# ─── Migración Masiva de Archivo — Almacenamiento y carpetas de red ──────────
# Requiere que las rutas de red (\\192.168.1.246, \\192.168.1.245 en el app de
# escritorio) esten montadas por el SO como CIFS/SMB en el servidor Linux, ver
# INFRA_MIGRACION_MASIVA_ARCHIVO.md punto 1.
MEDIA_ROOT=/var/lib/migracion-masiva-archivo/media
MIGRACION_ARCHIVOS_MEDIA_ROOT=/var/lib/migracion-masiva-archivo/media/migracion_masiva_archivo
MIGRACION_ARCHIVOS_TEMP_ROOT=/var/lib/migracion-masiva-archivo/tmp
MIGRACION_ARCHIVOS_MAX_UPLOAD_MB=100
MIGRACION_ARCHIVOS_SAIA_LIMITE=70
# Retencion de carpetas de uploads de lotes ya terminados (Celery Beat, 3:20 AM diario)
# — ver tasks.purgar_uploads_antiguos. Nunca toca lotes creados sobre una carpeta de red.
MIGRACION_ARCHIVOS_UPLOADS_RETENTION_DIAS=90
# Funcion "carpeta secundaria" (recuperacion de PEL faltantes vía .lnk de Windows):
# deshabilitada por diseño en este despliegue (servidor Linux). No cambiar a True
# sin antes leer INFRA_MIGRACION_MASIVA_ARCHIVO.md punto 2.
MIGRACION_ARCHIVOS_CARPETA_SECUNDARIA_HABILITADA=False
