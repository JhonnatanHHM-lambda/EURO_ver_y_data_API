# Genera con: python -c "import secrets; print(secrets.token_hex(50))"
SECRET_KEY=<clave-segura-generada>
DEBUG=False

# Hosts permitidos (Host header) — coma-separado, sin esquema ni puerto.
# 'localhost'/'127.0.0.1' se agregan siempre en settings.py, no hace falta repetirlos aquí.
ALLOWED_HOSTS=192.64.85.84

# Cookies seguras + redirect a HTTPS. Déjalo en False hasta CONFIRMAR en el
# servidor real cuál config de nginx/*.conf está activa (algunas sirven la API
# por HTTP plano, sin certificado — activar esto ahí rompe el sitio). Una vez
# confirmado que hay HTTPS real de punta a punta, cambiar a True.
SECURE_SSL_ENABLED=False
# Al activar SECURE_SSL_ENABLED, empezar con un valor bajo (1 hora) antes de
# subirlo a algo como 31536000 (1 año) — HSTS es dificil de revertir.
SECURE_HSTS_SECONDS=0

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=ver_y_data
DB_USER=postgres
DB_PASSWORD=<contraseña-segura>
DB_HOST=db
DB_PORT=5432

# MinIO — INTERNO: comunicación API→MinIO dentro de Docker
MINIO_ENDPOINT=minio:9000
MINIO_USE_HTTPS=False
MINIO_CERT_CHECK=False
# MinIO — PÚBLICO: IP del servidor (presigned URLs que abre el navegador)
MINIO_PUBLIC_ENDPOINT=192.64.85.84:9000
MINIO_PUBLIC_USE_HTTPS=False
MINIO_ACCESS_KEY=<access-key>
MINIO_SECRET_KEY=<secret-key-minimo-8-chars>
MINIO_BUCKET=euro-vyd
MINIO_BUCKET_CONTRATOS=euro-contratos

# JWT
ACCESS_TOKEN_LIFETIME=60
REFRESH_TOKEN_LIFETIME=1

# Email
EMAIL_USER=lambda.jhonnatan@gmail.com
EMAIL_PASS=<app-password-gmail>

# Celery + Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# CORS — origen del frontend (IP del servidor)
CORS_ALLOWED_ORIGINS=http://192.64.85.84

# URL base del frontend (para links de firma en emails)
FRONTEND_URL=http://192.64.85.84/ver-y-data

# SIESA (SQL Server)
SIESA_SERVER=190.158.6.93,20446
SIESA_DB=UNOEE
SIESA_UID=consultaeuro
SIESA_PWD=<password-siesa>

# Migración Masiva de Archivo — SAIA (servicio celery_migracion, ver docker-compose.yml)
SAIA_USER=<usuario-saia>
SAIA_PASSWORD=<password-saia>
SAIA_BASE_URL=https://eurosupermercados.netsaia.com/eurosupermercados/saia/index.php
SAIA_TIMEOUT_MS=30000
SAIA_MAX_REINTENTOS_RED=5
SAIA_CONSECUTIVO_DELTA_MAX=50
SAIA_MAX_FILE_MB=50
# Ruta DENTRO del contenedor celery_migracion (volumen migracion_saia_screenshots)
SAIA_SCREENSHOT_DIR=/app/saia_screenshots
SAIA_SCREENSHOT_RETENTION_DIAS=30

# Migración Masiva de Archivo — OCR (Tesseract, instalado en Dockerfile.celery-migracion)
TESSERACT_CMD=/usr/bin/tesseract
TESSDATA_DIR=/usr/share/tesseract-ocr/5/tessdata

# Migración Masiva de Archivo — carpetas y retención
# MEDIA_ROOT/MIGRACION_ARCHIVOS_MEDIA_ROOT usan el default de settings.py
# (/app/media/migracion_masiva_archivo), que coincide con el volumen
# migracion_media_data montado en api y celery_migracion — no sobreescribir aquí.
MIGRACION_ARCHIVOS_MAX_UPLOAD_MB=100
MIGRACION_ARCHIVOS_SAIA_LIMITE=70
MIGRACION_ARCHIVOS_UPLOADS_RETENTION_DIAS=90
# Deshabilitada por diseño (worker Linux) — ver INFRA_MIGRACION_MASIVA_ARCHIVO.md punto 2
MIGRACION_ARCHIVOS_CARPETA_SECUNDARIA_HABILITADA=False
